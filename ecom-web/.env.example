# Shared
NODE_ENV=development

# Web (apps/web)
NEXT_PUBLIC_APP_NAME=NONSENSE
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# API (apps/api)
PORT=5000
# Prefer MONGODB_URI; DATABASE_URL is kept for compatibility
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/forma?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/forma?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=http://localhost:3000

# Google OAuth (API)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Phone OTP — leave blank to log OTPs to console in development
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OTP_DEV_MODE=true

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin bootstrap (seed)
ADMIN_EMAIL=admin@nonsense.store
ADMIN_PHONE=+919999999999

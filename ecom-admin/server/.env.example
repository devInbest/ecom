# Runtime
NODE_ENV=development
PORT=5004

# Database
MONGODB_URI=mongodb://localhost:27017/ecom-admin

# Admin frontend (CORS + email links)
ADMIN_APP_URL=http://localhost:5176
FRONTEND_URL=http://localhost:5176
CORS_ORIGINS=http://localhost:5176

# JWT — use RS256 in production (recommended)
JWT_ISSUER=ecom-admin
JWT_AUDIENCE=ecom-admin-api
JWT_ALGORITHM=HS256
JWT_SECRET=change_this_in_production_use_long_random_string
# JWT_PRIVATE_KEY=
# JWT_PUBLIC_KEY=

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# Cookies (production)
# COOKIE_DOMAIN=.example.com

# Redis (recommended for production rate limiting)
# REDIS_URL=redis://localhost:6379

# Auth hardening
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15m
PASSWORD_RESET_TTL=1h
INVITATION_TTL=7d
EMAIL_VERIFICATION_TTL=24h
STEP_UP_AUTH_MAX_AGE=5m

# Email (password reset + invitations)
EMAIL_FROM=noreply@example.com
# EMAIL_PROVIDER_API_KEY=

# Seed defaults (pnpm seed) — password must be 12+ chars
SEED_ADMIN_EMAIL=admin@nonsense.store
SEED_ADMIN_PASSWORD=Admin@Secure123!
SEED_ADMIN_NAME=Super Admin

# Storefront API bridge
ECOM_WEB_API_URL=http://localhost:5000/api
ECOM_WEB_JWT_SECRET=change-me-to-a-long-random-string
ECOM_WEB_ADMIN_USER_ID=
ECOM_WEB_MONGODB_URI=mongodb://localhost:27017/forma
ECOM_WEB_ADMIN_EMAIL=admin@nonsense.store

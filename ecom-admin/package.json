{
  "name": "ecom-admin",
  "version": "0.1.0",
  "private": true,
  "description": "NONSENSE E-Commerce Admin Dashboard",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:server": "pnpm --filter server dev",
    "dev:client": "pnpm --filter client dev",
    "build": "pnpm run --filter client build",
    "start": "pnpm --filter server start",
    "seed": "pnpm --filter server seed",
    "resolve:ecom": "pnpm --filter server resolve:ecom"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0"
}
